{
  "manifest_version": 3,
  "name": "Writing Assistant Bridge",
  "version": "0.2.1",
  "description": "Connects focused browser editors to the local Writing Assistant app.",
  "permissions": ["activeTab"],
  "host_permissions": ["http://127.0.0.1:8766/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Writing Assistant Bridge",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
